rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── JOBS ──────────────────────────────────────────────────────────────────
    // Reads are open so share links (punch, home runs, questions, lighting)
    // work without login. Writes are validated lightly to prevent garbage data,
    // but we accept the actual shape the client sends: updated_at is an ISO
    // string (new Date().toISOString()), NOT a Firestore Timestamp — the app
    // has always written it that way. If a write lands without data/updated_at
    // that's almost certainly a bug or an attack, so we still require them.
    match /jobs/{jobId} {
      allow read: if true;

      allow write: if request.resource.data.keys().hasAll(['data', 'updated_at'])
                   && request.resource.data.data is map
                   && request.resource.data.updated_at is string;
      // The write rule only fires for create/update — delete passes a null
      // resource and would otherwise fail the key check. Allow it explicitly
      // so the app's job-archive path keeps working.
      allow delete: if true;
    }

    // ── MANUAL TASKS ──────────────────────────────────────────────────────────
    // Ad-hoc task list outside the job records. Same shape as /jobs (data map
    // + ISO updated_at string), so we apply the same light validation.
    match /manualTasks/{taskId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['data', 'updated_at'])
                   && request.resource.data.data is map
                   && request.resource.data.updated_at is string;
      allow delete: if true;
    }

    // ── QUOTE WALKS ───────────────────────────────────────────────────────────
    // Pre-job site walk notes (replaces Apple Notes capture). Same shape as
    // /jobs and /manualTasks — data map + ISO updated_at string. UI-level
    // permission checks handle who sees walks (admin + foreman roles).
    match /quoteWalks/{walkId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['data', 'updated_at'])
                   && request.resource.data.data is map
                   && request.resource.data.updated_at is string;
      allow delete: if true;
    }

    // Redline walks — same envelope + validation as /quoteWalks (data map + ISO
    // updated_at string). UI-level permission controls who edits.
    match /redlineWalks/{walkId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['data', 'updated_at'])
                   && request.resource.data.data is map
                   && request.resource.data.updated_at is string;
      allow delete: if true;
    }

    // ── LINK OPENS ────────────────────────────────────────────────────────────
    // Share-link open counters, one doc per job (spec 2026-10-07-link-opens).
    // Public share pages bump them; the office reads them. Never on jobs/{id}.
    // Nothing sensitive and nothing decides on it, so writes are open like the
    // rest of the share surface — but the shape is fixed and nobody can delete.
    match /link_opens/{jobId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['links', 'updated_at'])
                            && request.resource.data.links is map
                            && request.resource.data.updated_at is string
                            && request.resource.data.links.size() <= 300;
      allow delete: if false;
    }

    // ── HOMEOWNER REQUESTS ────────────────────────────────────────────────────
    // Share link recipients submit answers here — allow creates from anyone.
    // Only the app reads these back, so reads are also open for now.
    match /homeowner_requests/{docId} {
      // Share-link recipients submit AND resubmit answers here; the app also
      // writes gen-load + lighting-collab requests to the same doc. Validate
      // lightly (jobId must be a string, consistent with /jobs) and allow
      // updates so resubmits/edits work. Never allow deletes.
      allow read: if true;
      allow create: if request.resource.data.jobId is string;
      allow update: if request.resource.data.jobId is string;
      allow delete: if false;

      // ── VERSION SNAPSHOTS (Kweller hardening Layer 4, 2026-07-09) ────────
      // Point-in-time copies stashed by saveHomeownerRequest() before every
      // write (public share pages AND internal app), so a bad merge or
      // overwrite is a 2-minute restore instead of a loss. Same open posture
      // as the parent doc — no auth model to gate on. Immutable once written
      // (no update); delete allowed so the client can prune to the last 10.
      match /versions/{versionId} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if true;
      }
    }

    // ── QUESTION SHARES ───────────────────────────────────────────────────────
    // Stores live share sessions for the Questions share feature.
    // Reads are open so recipients can see which questions are included.
    // Creates are open so the app can generate new sessions.
    // Updates allowed so the sender can add/remove questions after the fact.
    match /question_shares/{shareId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['jobId', 'questionIds', 'createdAt'])
                    && request.resource.data.jobId is string
                    && request.resource.data.questionIds is list;
      allow update: if request.resource.data.keys().hasAll(['questionIds', 'updatedAt'])
                    && request.resource.data.questionIds is list;
      allow delete: if false;
    }

    // ── SETTINGS ──────────────────────────────────────────────────────────────
    // Shared app settings (user list, scoreboard weight defaults, etc).
    // Reads are open so the app can bootstrap without login. Writes are open
    // in the same spirit as /jobs — the app protects these with UI-level
    // permission checks rather than Firestore auth (consistent with how the
    // rest of the app works today).
    match /settings/{docId} {
      allow read: if true;
      // v546 (batch 1, "stop the bad writes"): the team list may never SHRINK by
      // more than one person in a single write. Removing one person is a real
      // edit; a list that drops two or more is a stale phone (the sign-in screen
      // used to be able to write a one-person list over the whole company while
      // the real list was still loading). Everything else in /settings is open as
      // before. Per the version-lock rule, the lock lives here, not in a popup.
      allow create, update: if docId != "users" || teamListNotShrunk();
      allow delete: if docId != "users";
    }
    function teamListNotShrunk() {
      return request.resource.data.list is list
          && (resource == null
              || !("list" in resource.data)
              || !(resource.data.list is list)
              || request.resource.data.list.size() + 1 >= resource.data.list.size());
    }

    // ── CONFIG ────────────────────────────────────────────────────────────────
    // App-wide config flags (e.g. force-update version). Same read/write
    // posture as /settings.
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── SUGGESTIONS ───────────────────────────────────────────────────────────
    // Crew-submitted feature requests / bug reports / improvements, surfaced
    // on the App Map tab. Creates accepted from anyone (anonymous OK so the
    // share URL can also collect — though current UI only shows the form
    // when logged in). Reads open so admin/manager can see the inbox.
    // Updates allowed (Koy changes status + notes during triage). Deletes
    // allowed so cleared / spammy entries can be removed.
    match /suggestions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['text', 'submittedAt', 'status'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 5000;
      allow update: if true;
      allow delete: if true;
    }

    // ── NEEDS BOARD ───────────────────────────────────────────────────────────
    // Coordinator board for deadline-bound contractor call-in needs. Same shape
    // as /manualTasks and /quoteWalks (data map + ISO updated_at string), so the
    // same light validation applies. UI-level board.add permission controls who
    // can write; reads open to match the rest of the app.
    match /needs/{needId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['data', 'updated_at'])
                   && request.resource.data.data is map
                   && request.resource.data.updated_at is string;
      allow delete: if true;
    }

    // ── MEETINGS (SW v648) ────────────────────────────────────────────────────
    // /dashboard › Meetings: the Weekly Scramble's and (v649) Lead Meeting's notes, row notes, action items
    // and the section adds / hides (src/meetingModel.js has the shape). Same open
    // posture as /needs; a write must say what it is and when. Never deleted from
    // the app (a past week is history).
    match /meetings/{meetingId} {
      allow read: if true;
      allow create, update: if request.resource.data.type in ['scramble', 'scramble_prefs', 'lead', 'lead_prefs']
                    && request.resource.data.updated_at is string;
      allow delete: if false;
    }

    // ── NOTIFICATION INBOX ────────────────────────────────────────────────────
    // Per-user in-app notification inbox: notifications/{userKey}/items/{id}.
    // ONLY Cloud Functions create these (admin SDK bypasses rules), so client
    // creates are denied. Clients may read, flip the read flag (and nothing
    // else — enforced via affectedKeys), and delete (clear) their items.
    // Reads open to match the rest of the app's posture (UI scopes by user).
    match /notifications/{userKey}/items/{itemId} {
      allow read: if true;
      allow create: if false;
      // v551 (UX batch 0): the app also stamps when / how an item was read, in a
      // second write after the read flip. Still nothing else on the item changes.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readVia']);
      allow delete: if true;
    }

    // ── GC PORTAL (outside-facing; 08-Specs/GC Portal Link Spec.md) ──────────
    // gc_links/{token}: the token IS the secret → direct get only, NEVER list
    // (list would enumerate every contractor's token). Client writes DENIED —
    // an outsider holding a token must not be able to alter exposure (gcKey,
    // revoked, contacts). The office manages links via the gcPortal* callables
    // (admin SDK bypasses rules).
    match /gc_links/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // gc_portal/{portalId}: the WHITELISTED per-job mirror the portal page
    // reads. portalId is unguessable (capability, like the token). Written
    // ONLY by Cloud Functions; jobs/{id} rules are untouched by this feature.
    match /gc_portal/{portalId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
      match /jobs/{jobId} {
        allow get, list: if true;
        allow write: if false;
      }
    }

    // gc_requests/{reqId}: the GC-side funnel (dates, threads, punch, answers).
    // FULLY function-managed (Piece 4): every write goes through the
    // gcPortalSubmit callable, which validates the link token server-side and
    // writes via the admin SDK. So NO client access at all — create/read/update/
    // delete all denied. This is the strongest posture: the stored token can't
    // be enumerated (no read), the queue can't be spammed/tampered/wiped (no
    // client write), and the office reads via gcPortalListRequests (admin SDK).
    match /gc_requests/{reqId} {
      allow read, write: if false;
    }

    // gc_config/{docId}: server-only config for the notification engine — most
    // importantly gc_config/mail holds the email PROVIDER KEY. NEVER client-
    // readable (a leaked key = spam/abuse) or writable. Only Cloud Functions
    // (admin SDK) touch it; Koy sets it via the console or an admin callable.
    match /gc_config/{docId} {
      allow read, write: if false;
    }

    // gc_notify_queue/{id}: the outbound email queue (quiet-hours instants wait
    // here for their morning sendAt). Written and drained ONLY by Cloud Functions;
    // the HTML bodies could contain contractor data, so no client access at all.
    match /gc_notify_queue/{id} {
      allow read, write: if false;
    }

    // gc_rate/{token}: Phase 0 fixed-window rate-limit counters for
    // gcPortalSubmit (gcCheckRateLimit). Function-only — a client that could
    // read or reset its own counter would defeat the whole point of the limit.
    match /gc_rate/{token} {
      allow read, write: if false;
    }

    // gc_bounces/{id}: Phase 0 SendGrid bounce/complaint webhook records
    // (gcSendGridWebhook). Function-only — written by the webhook handler via
    // admin SDK, read only by future admin tooling (also via admin SDK).
    match /gc_bounces/{id} {
      allow read, write: if false;
    }

    // ── PLAN INTAKE FINDINGS (PLAN_INTAKE_SPEC.md Phase 4, 2026-10-04) ────────
    // agentFindings/{id}: what the plan-intake functions did (folders made,
    // plans filed, plans the Routine wasn't sure of). Written ONLY by Cloud
    // Functions (admin SDK). The Today → Plans card reads them and may stamp
    // seen / seenAt / seenBy — nothing else (same pattern as notifications).
    // agentQueue and planIntakeState stay function-only via the catch-all below.
    match /agentFindings/{id} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt', 'seenBy']);
    }

    // ── PROJECTS (multi-building) ─────────────────────────────────────────────
    // Projects spec 2026-10-15. A project groups normal jobs (buildings) via
    // job.data.projectGroupId. Same envelope + light validation as /needs.
    // Never deleted — archived:true inside data (spec §9).
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['data', 'updated_at'])
                            && request.resource.data.data is map
                            && request.resource.data.updated_at is string;
      allow delete: if false;
    }

    // ── CLAUDE REPORTS (SW v616) ──────────────────────────────────────────────
    // claude_reports/{id}: reports Claude files for Koy (game plans, material
    // reports, margin math). Some carry dollar figures, so the app gets NO
    // access at all: duetApi (admin SDK) writes them and the live-PIN callable
    // claudeReports reads them, sending owners-only reports to admins alone.
    // This block says the same thing as the catch-all below; it is written out
    // so nobody opens the collection by accident when the job rules change.
    match /claude_reports/{id} {
      allow read, write: if false;
    }

    // claude_routines/{trig_…} and claude_flags/{flg_…} (SW v633): the Claude
    // tab's Automations list and Needs you flags. Server-only, like the reports:
    // written only by duetApi (routine.* / flag.*), read only through the
    // admin-PIN callable claudeWork, answered only through claudeFlagAnswer
    // (Koy's record). Same as the catch-all deny; spelled out so nobody opens it.
    match /claude_routines/{id} {
      allow read, write: if false;
    }
    match /claude_flags/{id} {
      allow read, write: if false;
    }

    // ── RATE YOUR CREW (SW v645, 2026-11-16) ──────────────────────────────────
    // Foremen, leads and jr. foremen rate their crew from a standalone page
    // (/rate/?r=<token>), not from inside the app. The page can WRITE answers
    // and read only what its own link opens; nothing on the client can LIST or
    // read another rater's answers. Koy reads them with the admin SDK.
    //   crewRaters/{token}      one per rater; the token IS the secret (like
    //                           gc_links): direct get only, never list, no writes.
    //                           Holds { raterId, name, people[ids], peopleCards[] }.
    //   crewRatingRounds/current  { id, startsOn, closesAt }: get only, no writes.
    //   crewRatings/{round__token__personId}  one answer per rater + person + round.
    //                           The doc id carries the rater's secret token, so a
    //                           get needs that token; list and delete are denied.
    //                           A write must: use a real token, name someone on
    //                           that rater's list, hit the open round, rate all 5
    //                           areas 1-4 with a why, and carry nothing else. No
    //                           pay, margin or dollar field can be stored.
    match /crewRaters/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    match /crewRatingRounds/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    match /crewRatings/{docId} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create, update: if ratingWriteOk(docId, request.resource.data);
    }
    function ratingScoreOk(v) { return v is int && v >= 1 && v <= 4; }
    // a plain Solid (3) needs no why; every other rating must say why
    function ratingWhyOk(v, s) { return v is string && v.size() <= 500 && (s == 3 || v.size() >= 3); }
    function ratingWriteOk(docId, d) {
      let p = docId.split('__');
      return p.size() == 3
        && exists(/databases/$(database)/documents/crewRaters/$(p[1]))
        && p[2] in get(/databases/$(database)/documents/crewRaters/$(p[1])).data.people
        && get(/databases/$(database)/documents/crewRatingRounds/current).data.id == p[0]
        && request.time < get(/databases/$(database)/documents/crewRatingRounds/current).data.closesAt
        && d.keys().hasOnly(['roundId', 'raterToken', 'raterId', 'personId', 'scores', 'why', 'other', 'kudos', 'updatedAt'])
        && d.keys().hasAll(['roundId', 'raterToken', 'raterId', 'personId', 'scores', 'why', 'other', 'updatedAt'])
        && d.roundId == p[0] && d.raterToken == p[1] && d.personId == p[2]
        && d.raterId == get(/databases/$(database)/documents/crewRaters/$(p[1])).data.raterId
        && d.scores is map && d.scores.keys().hasOnly(['quality', 'pace', 'reliability', 'attitude', 'leading'])
        && d.scores.keys().hasAll(['quality', 'pace', 'reliability', 'attitude', 'leading'])
        && ratingScoreOk(d.scores.quality) && ratingScoreOk(d.scores.pace) && ratingScoreOk(d.scores.reliability)
        && ratingScoreOk(d.scores.attitude) && ratingScoreOk(d.scores.leading)
        && d.why is map && d.why.keys().hasOnly(['quality', 'pace', 'reliability', 'attitude', 'leading'])
        && d.why.keys().hasAll(['quality', 'pace', 'reliability', 'attitude', 'leading'])
        && ratingWhyOk(d.why.quality, d.scores.quality) && ratingWhyOk(d.why.pace, d.scores.pace) && ratingWhyOk(d.why.reliability, d.scores.reliability)
        && ratingWhyOk(d.why.attitude, d.scores.attitude) && ratingWhyOk(d.why.leading, d.scores.leading)
        && d.other is string && d.other.size() <= 1000
        && (!('kudos' in d) || (d.kudos is string && d.kudos.size() <= 500))
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }

    // crewFeedback/{round__token}: a rater's one anonymous note on what would make the job better.
    // Same token + open-round checks as crewRatings; Koy reads it through the sync, never a client.
    match /crewFeedback/{docId} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create, update: if feedbackWriteOk(docId, request.resource.data);
    }
    function feedbackWriteOk(docId, d) {
      let p = docId.split('__');
      return p.size() == 2
        && exists(/databases/$(database)/documents/crewRaters/$(p[1]))
        && get(/databases/$(database)/documents/crewRatingRounds/current).data.id == p[0]
        && request.time < get(/databases/$(database)/documents/crewRatingRounds/current).data.closesAt
        && d.keys().hasOnly(['roundId', 'raterToken', 'raterId', 'text', 'updatedAt'])
        && d.keys().hasAll(['roundId', 'raterToken', 'raterId', 'text', 'updatedAt'])
        && d.roundId == p[0] && d.raterToken == p[1]
        && d.raterId == get(/databases/$(database)/documents/crewRaters/$(p[1])).data.raterId
        && d.text is string && d.text.size() >= 3 && d.text.size() <= 1000
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }

    // crewUpward/{round__token}: a rater's anonymous scores for how Koy is doing (seven questions,
    // 1-4, plus one thing to start and one to stop). Same token + open-round checks as crewRatings.
    // The artifact never shows who wrote what; only the sync reads these.
    match /crewUpward/{docId} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create, update: if upwardWriteOk(docId, request.resource.data);
    }
    function upwardScoreOk(v) { return v is int && v >= 1 && v <= 4; }
    function upwardWriteOk(docId, d) {
      let p = docId.split('__');
      return p.size() == 2
        && exists(/databases/$(database)/documents/crewRaters/$(p[1]))
        && get(/databases/$(database)/documents/crewRatingRounds/current).data.id == p[0]
        && request.time < get(/databases/$(database)/documents/crewRatingRounds/current).data.closesAt
        && d.keys().hasOnly(['roundId', 'raterToken', 'raterId', 'scores', 'start', 'stop', 'updatedAt'])
        && d.keys().hasAll(['roundId', 'raterToken', 'raterId', 'scores', 'start', 'stop', 'updatedAt'])
        && d.roundId == p[0] && d.raterToken == p[1]
        && d.raterId == get(/databases/$(database)/documents/crewRaters/$(p[1])).data.raterId
        && d.scores is map
        && d.scores.keys().hasOnly(['direction', 'available', 'obstacles', 'fair', 'followthrough', 'listens', 'setup'])
        && d.scores.keys().hasAll(['direction', 'available', 'obstacles', 'fair', 'followthrough', 'listens', 'setup'])
        && upwardScoreOk(d.scores.direction) && upwardScoreOk(d.scores.available) && upwardScoreOk(d.scores.obstacles)
        && upwardScoreOk(d.scores.fair) && upwardScoreOk(d.scores.followthrough) && upwardScoreOk(d.scores.listens)
        && upwardScoreOk(d.scores.setup)
        && d.start is string && d.start.size() <= 500 && d.stop is string && d.stop.size() <= 500
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }

    // ── EVERYTHING ELSE ───────────────────────────────────────────────────────
    // Deny all access to any other collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
